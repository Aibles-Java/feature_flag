# Copy to .env (git-ignored) and fill in real values.
# docker-compose reads this file automatically; the Spring app reads the same
# variables from its process environment. See README.md "Environment variables".

# --- docker-compose Postgres (local defaults shown) ---
POSTGRES_DB=feature_flag_db
POSTGRES_USER=ff_user
POSTGRES_PASSWORD=ff_password

# --- Spring app: REQUIRED for `docker compose up` ---
# The image bakes SPRING_PROFILES_ACTIVE=prod, and the prod profile has no defaults, so the
# compose `app` service refuses to start without this. `./mvnw spring-boot:run` does not need it
# (the default profile carries local-dev values).
# >= 64 UTF-8 bytes (512 bits); generate with: openssl rand -hex 64
APP_JWT_SECRET=

# --- Spring app: only when running outside compose with SPRING_PROFILES_ACTIVE=prod ---
# (compose derives these from the POSTGRES_* values above)
#SPRING_PROFILES_ACTIVE=prod
#SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/feature_flag_db
#SPRING_DATASOURCE_USERNAME=ff_user
#SPRING_DATASOURCE_PASSWORD=
