<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!--
      Used ONLY by ApiKeyBackfillTest (via spring.liquibase.change-log), never by
      db.changelog-master.xml. Runs core (001-019), then the test-only seed fixture — inserted
      while environments.api_key_hash still exists — then 020 (the real backfill + column drop),
      so the test can assert the seeded pre-migration key survives the cutover.

      Everything db.changelog-master.xml includes after 020 must follow here too: the test boots
      the real entities, so a column a later changeset adds (022's change_window_timezone) has
      to exist or every query fails.
    -->

    <include file="db/changelog/db.changelog-core.xml"/>
    <include file="db/changelog/020-0-seed-backfill-fixture.xml"/>
    <include file="db/changelog/migrations/020-migrate-api-keys-to-key-table.xml"/>
    <include file="db/changelog/migrations/021-allow-member-role.xml"/>
    <include file="db/changelog/migrations/022-add-change-window-timezone.xml"/>
    <include file="db/changelog/migrations/024-backfill-missing-flag-environment-states.xml"/>

</databaseChangeLog>
