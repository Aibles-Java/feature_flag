<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="008-add-rollout-percent" author="dev">
        <addColumn tableName="flag_environment_states">
            <column name="rollout_percent" type="INTEGER" defaultValueNumeric="100">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <sql>ALTER TABLE flag_environment_states
             ADD CONSTRAINT chk_rollout_percent CHECK (rollout_percent BETWEEN 0 AND 100)</sql>
        <rollback>
            <dropColumn tableName="flag_environment_states" columnName="rollout_percent"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
