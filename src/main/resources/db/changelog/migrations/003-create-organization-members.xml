<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="003-create-organization-members" author="dev">
        <createTable tableName="organization_members">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="organization_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_org_members_organization"
                             references="organizations(id)"
                             deleteCascade="true"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_org_members_user"
                             references="users(id)"
                             deleteCascade="true"/>
            </column>
            <column name="role" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="organization_members"
                             columnNames="organization_id, user_id"
                             constraintName="uq_org_members_org_user"/>
        <sql>ALTER TABLE organization_members ADD CONSTRAINT chk_org_member_role
            CHECK (role IN ('OWNER', 'ADMIN', 'VIEWER'))</sql>
        <rollback>
            <dropTable tableName="organization_members"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
